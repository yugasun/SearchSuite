{
  "name": "searchsuite",
  "version": "0.1.3",
  "description": "A type-safe TypeScript SDK for Baidu, Doubao, Tavily, Exa, and Serper search.",
  "keywords": [
    "search",
    "web-search",
    "typescript",
    "sdk",
    "ai-agent",
    "rag",
    "baidu",
    "doubao",
    "tavily",
    "exa",
    "serper"
  ],
  "homepage": "https://github.com/yugasun/SearchSuite#readme",
  "bugs": {
    "url": "https://github.com/yugasun/SearchSuite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yugasun/SearchSuite.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run test/unit test/contract",
    "test:live": "vitest run test/integration",
    "test:watch": "vitest",
    "pack:check": "pnpm build && pnpm exec publint",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm exec publint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "^24.0.0",
    "oxlint": "^1.79.0",
    "publint": "^0.3.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
